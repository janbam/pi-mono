{
	"name": "@earendil-works/pless",
	"version": "1.6.0",
	"description": "Markdown pager CLI built on pi-tui's markdown renderer, with less-style multi-file navigation",
	"type": "module",
	"bin": {
		"pless": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs executable dist/cli.js",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"markdown",
		"pager",
		"less",
		"terminal",
		"cli",
		"tui"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/pless"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.6.0",
		"@earendil-works/pi-tui": "1.6.0"
	}
}
